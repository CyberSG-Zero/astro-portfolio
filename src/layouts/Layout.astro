---
import '@fontsource-variable/gabarito';
import '@fontsource-variable/open-sans/wght-italic.css';
import '../styles/styles.css';
import '../styles/infinite-slider.css';
import '../styles/counter.css';

import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { ViewTransitions } from 'astro:transitions';
const { title, description } = Astro.props
const canonicalURL = Astro.url.href

---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:image" content="/myself.avif">
		<link rel="icon" type="image/svg+xml" href="/myself.avif" />
		<meta name="generator" content={Astro.generator} />

		<link rel="sitemap" href="/sitemap-index.xml" />

		<script type="module" src="../js/mouse.js"></script>
		<ViewTransitions />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<script type="application/ld+json">
			{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "Person",
					"name": "Luis Salas",
					"alternateName": "CyberSG",
					"url": "https://cybersg.dev",
					"image": "https://cybersg.dev/myself.avif",
					"jobTitle": "Freelance Web Developer",
					"description": "Freelancer Web Developer with illustrations and graphic skills to solve digital problems. Specialized in UX/UI design, frontend development, and visual design.",
					"knowsAbout": ["Web Development", "UX/UI Design", "Frontend Development", "Visual Design", "Graphic Design"],
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Barcelona",
						"addressCountry": "ES"
					},
					"contactPoint": {
						"@type": "ContactPoint",
						"contactType": "customer service",
						"email": "luissalas2706@gmail.com"
					},
					"sameAs": [
						"https://www.instagram.com/cybersg_zero/",
						"https://www.linkedin.com/in/cybersg/",
						"https://github.com/CyberSG-Zero"
					]
				},
				{
					"@type": "Organization",
					"name": "CyberSG",
					"url": "https://cybersg.dev",
					"logo": "https://cybersg.dev/myself.avif",
					"description": "CyberSG is a Freelancer Web Developer with illustrations and graphic skills to solve your digital problems. Contact me today to discuss your project!",
					"contactPoint": {
						"@type": "ContactPoint",
						"contactType": "customer service",
						"email": "luissalas2706@gmail.com"
					},
					"sameAs": [
						"https://www.instagram.com/cybersg_zero/",
						"https://www.linkedin.com/in/cybersg/",
						"https://github.com/CyberSG-Zero"
					]
				},
				{
					"@type": "WebSite",
					"url": "https://cybersg.dev",
					"name": "CyberSG Portfolio",
					"description": "Portfolio of CyberSG - Freelance Web Developer and UX/UI Designer",
					"publisher": {
						"@type": "Person",
						"name": "Luis Salas"
					}
				}
			]
			}
		</script>

		<script defer type="text/javascript">
			(function(c,l,a,r,i,t,y){
				c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
				t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
				y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
			})(window, document, "clarity", "script", "uj1cldalzc");
		</script>

		<script defer>
			document.addEventListener('astro:page-load', () => {
				document.querySelectorAll('video[autoplay]').forEach(v => {
					v.load();
					v.play().catch(() => {});
				});
			});
		</script>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<div class="cursor"></div>
		<Header />
		<main id="main-content" role="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>


