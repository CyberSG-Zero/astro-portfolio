---
import ArrowRight from '../icons/ArrowRight.astro';
import GitHub from '../icons/GitHub.astro';
import Instagram from '../icons/Instagram.astro';
import LinkedIn from '../icons/LinkedIn.astro';
import { localizePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<footer role="contentinfo">
    <div class="footer">
      <div class="footer-image">
        <img loading="lazy" class="image" src="/images/myself.avif" alt="CyberSG" />
      </div>
      <div class="footer-section">
        <a class="footer-link" href={localizePath(lang, '/')}>{t('footer.home')}</a>
        <a class="footer-link" href={localizePath(lang, '/work')}>{t('footer.work')}</a>
        <a class="footer-link" href={localizePath(lang, '/contact')}>{t('footer.contact')}</a>
      </div>

      <div class="footer-section contact">
        <div class="contact-block">
          <span>{t('footer.prompt')}</span>
          {t('footer.sub')}
        </div>
        <a class="button outlink" href={localizePath(lang, '/contact')}> {t('footer.cta')}
					<ArrowRight />
				</a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copyright">{t('footer.rights')}</div>
      <div class="social-icons">
        <a class="social-icon" href="https://www.instagram.com/cybersg_zero/"
          target="_blank"
          aria-label={t('a11y.instagram')}>
            <Instagram aria-hidden="true" width="24" height="24" />
        </a>
        <a class="social-icon" href="https://www.linkedin.com/in/cybersg/" target="_blank" aria-label={t('a11y.linkedin')}>
            <LinkedIn aria-hidden="true" width="24" height="24" />
        </a>
        <a class="social-icon" href="https://github.com/CyberSG-Zero" target="_blank" aria-label={t('a11y.github')}>
          <GitHub aria-hidden="true" width="24" height="24" />
        </a>
      </div>
    </div>
</footer>
