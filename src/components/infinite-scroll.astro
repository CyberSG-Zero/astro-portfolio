---
import Chrome from '../icons/Chrome.astro';
import JavaScript from '../icons/JavaScript.astro';
import Skill128A from '../icons/Skill128A.astro';
import Skill128B from '../icons/Skill128B.astro';
import Skill256WhiteA from '../icons/Skill256WhiteA.astro';
import Skill256WhiteB from '../icons/Skill256WhiteB.astro';
import Skill27A from '../icons/Skill27A.astro';
import SkillA from '../icons/SkillA.astro';
import SkillB from '../icons/SkillB.astro';
import SkillC from '../icons/SkillC.astro';
import SkillD from '../icons/SkillD.astro';
import SkillE from '../icons/SkillE.astro';
import SkillF from '../icons/SkillF.astro';
import SkillG from '../icons/SkillG.astro';
import SkillH from '../icons/SkillH.astro';
import Tailwind from '../icons/Tailwind.astro';
---

<section class="section">
    <div class="infinite-scroll">
            <div class="skill-img item1">
                <SkillA width="24" height="24" />
            </div>
            <div class="skill-img item2">
                <Skill128A width="128" height="128" />
            </div>
            <div class="skill-img item3">
                <Skill128B width="128" height="128" />
            </div>
            <div class="skill-img item4">
                <SkillB width="24" height="24" />
            </div>
            <div class="skill-img item5">
                <SkillC width="24" height="24" />
            </div>
            <div class="skill-img item6">
                <SkillD width="24" height="24" />
            </div>
            <div class="skill-img item7">
                <SkillE width="24" height="24" />
            </div>
            <div class="skill-img item8">
                <Tailwind width="24" height="24" />
            </div>
    </div>

        <div class="infinite-scroll">
            <div class="skill-img inverted item1">
                <Skill256WhiteA />
            </div>
            <div class="skill-img inverted item2">
                <SkillF />
            </div>
            <div class="skill-img inverted item3">
                <SkillG />
            </div>
            <div class="skill-img inverted item4">
                <Skill27A width="27" height="24" />
            </div>
            <div class="skill-img inverted item5">
                <Chrome />
            </div>
            <div class="skill-img inverted item6">
                <SkillH />
            </div>
            <div class="skill-img inverted item7">
                <Skill256WhiteB />
            </div>
            <div class="skill-img inverted item8">
                <JavaScript />
            </div>
        </div>
</section>