  ca: {
    metaTitle: 'Parlem | CyberSG',
    metaDesc:
      "CyberSG és un desenvolupador web freelance amb habilitats d'il·lustració i disseny gràfic per resoldre els teus problemes digitals. Parlem del teu projecte!",
