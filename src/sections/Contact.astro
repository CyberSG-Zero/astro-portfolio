    message: 'Missatge',
    messagePlaceholder: 'El teu missatge',
    legend: 'Selecciona una opció:',
    motiveWork: 'Per treballar junts | ˆᴗˆ |',
    motiveTalk: 'Per xerrar una estona | >ᴗ< |',
    consent:
      'Accepto que aquest lloc web emmagatzemi la informació enviada per poder respondre a la meva consulta.',
    send: 'Envia el missatge',
    sending: 'Enviant...',
    error: 'Alguna cosa ha anat malament. Torna-ho a provar.',
    formError: 'Corregeix els camps marcats.',
    networkError: 'No hem pogut connectar. Torna-ho a provar.',
    fieldErrors: {
      name: 'Escriu el teu nom.',
      company: "Escriu el nom de l'empresa.",
      email: 'Escriu un correu electrònic vàlid (p. ex. nom@empresa.com).',
      message: 'Escriu un missatge.',
      consent: 'Accepta la casella de consentiment.',
    },
    thanksPath: '/gracies',
    contactLd:
      "Posa't en contacte amb CyberSG - Desenvolupador web freelance. Disponible per a projectes de desenvolupament web, disseny UX/UI i disseny visual.",
  },
} as const;

const c = copy[lang];
const thanksUrl = localizePath(lang, c.thanksPath);

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: c.metaTitle,
  description: c.contactLd,
  url: new URL(localizePath(lang, '/contact'), Astro.site ?? new URL('https://cybersg.dev')).href,
  inLanguage: lang,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: 'luissalas2706@gmail.com',
    availableLanguage: ['English', 'Spanish', 'Catalan'],
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Barcelona',
    addressCountry: 'ES',
    addressRegion: 'Catalonia',
  },
};
---

<BaseLayout lang={lang} title={c.metaTitle} description={c.metaDesc} jsonLd={contactLd}>
  <!-- contact -->
  <section class="section layout-split">
    <div class="contact-col">
      <div class="block">
        <div class="content-subtitle">{c.subtitle}</div>
        <div class="heading-row">
          <h1 class="section-title">{c.heading}</h1>
          <BrandMark class="ani-icon" width="30" height="30" />
        </div>
      </div>
      <div class="content-description prose">
        <p set:html={c.intro}></p>
      </div>
      <div class="social-icons">
        <a class="social-icon" href="https://www.instagram.com/cybersg_zero/" target="_blank" aria-label={t('a11y.instagram')}>
          <Instagram aria-hidden="true" width="24" height="24" />
        </a>
        <a class="social-icon" href="https://www.linkedin.com/in/cybersg/" target="_blank" aria-label={t('a11y.linkedin')}>
          <LinkedIn aria-hidden="true" width="24" height="24" />
        </a>
        <a class="social-icon" href="https://github.com/CyberSG-Zero" target="_blank" aria-label={t('a11y.github')}>
          <GitHub aria-hidden="true" width="24" height="24" />
        </a>
      </div>

      <div class="block">
        <h2 class="content-subtitle">{c.inquiry}</h2>
        <a class="email-link" href="javascript:void(0)" id="copyEmail">
          <span>contacto</span>
          <span>@</span>
          <span>cybersg.dev</span>
        </a>
        <span id="copyMessage">{c.copied}</span>
      </div>
      <div>{c.location}</div>
    </div>

    <div class="contact-col">
      <form
        class="contact-form"
        id="contacto-form"
        method="POST"
        novalidate
        data-thanks={thanksUrl}
        data-sending={c.sending}
        data-error={c.error}
        data-send={c.send}
        data-form-error={c.formError}
        data-network-error={c.networkError}
        data-field-errors={JSON.stringify(c.fieldErrors)}
      >
        <input type="text" name="website_url" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">

        <label for="contact-name">
          {c.name}
          <input type="text" id="contact-name" name="name" placeholder={c.namePlaceholder} autocomplete="name" maxlength="100" aria-describedby="error-name" required />
          <span class="field-error" id="error-name" aria-live="polite"></span>
        </label>

        <label for="contact-company">
          {c.company}
          <input type="text" id="contact-company" name="company" placeholder={c.companyPlaceholder} autocomplete="organization" maxlength="100" aria-describedby="error-company" required />
          <span class="field-error" id="error-company" aria-live="polite"></span>
        </label>

        <label for="contact-email">
          {c.email}
          <input type="email" id="contact-email" name="email" placeholder={c.emailPlaceholder} autocomplete="email" maxlength="200" aria-describedby="error-email" required />
          <span class="field-error" id="error-email" aria-live="polite"></span>
        </label>

        <label for="contact-message">
          {c.message}
          <textarea id="contact-message" name="message" placeholder={c.messagePlaceholder} maxlength="2000" aria-describedby="error-message" required></textarea>
          <span class="field-error" id="error-message" aria-live="polite"></span>
        </label>

        <fieldset>
          <legend>{c.legend}</legend>

          <div class="radio">
            <input type="radio" id="motive-work" name="Motive" value="work-together" checked />
            <label for="motive-work">{c.motiveWork}</label>
          </div>

          <div class="radio">
            <input type="radio" id="motive-talk" name="Motive" value="talk-together" />
            <label for="motive-talk">{c.motiveTalk}</label>
          </div>
        </fieldset>

        <label class="checkbox" for="consent">
          {c.consent}
          <input type="checkbox" id="consent" name="consent" aria-describedby="error-consent" required />
          <span class="check"></span>
        </label>
        <span class="field-error" id="error-consent" aria-live="polite"></span>

        <button type="submit" disabled>{c.send}</button>
        <p id="contacto-estado" class="contact-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <script is:inline src="/js/copy_to_clipboard.js" defer></script>

  <script>
    import { initContactForm } from '../scripts/contact-form';

    initContactForm();
    document.addEventListener('astro:page-load', initContactForm);
  </script>
</BaseLayout>
