    metaTitle: 'Hablemos | CyberSG',
    metaDesc:
      'CyberSG es un desarrollador web freelance con habilidades de ilustración y diseño gráfico para resolver tus problemas digitales. ¡Hablemos de tu proyecto!',
    subtitle: 'Contacto',
    heading: 'Hablemos juntos',
    intro:
