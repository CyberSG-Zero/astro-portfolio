---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocument from '../components/LegalDocument.astro';
import { legalTerms } from '../i18n/legal';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const doc = legalTerms[lang];
---

<BaseLayout lang={lang} title={doc.metaTitle} description={doc.metaDesc}>
  <LegalDocument doc={doc} lang={lang} />
</BaseLayout>
