      },
    ],
    projects: [
      { slug: 'Rectangle', title: 'El Rectangle | Open Kitchen Bar', year: '2026' },
      { slug: 'e-Qapla', title: 'Landing page - e-Qapla', year: '2025' },
      { slug: 'Inmape', title: 'Rediseño web - Inmape', year: '2025' },
      { slug: 'ArquiTechPro', title: 'ArquiTechPro', year: '2024' },
      { slug: 'Intrepido_Cacao', title: 'Proyecto: Intrépido Cacao', year: '2023' },
      { slug: 'Anilist', title: 'Anilist [//] MobileApp', year: '2022' },
      { slug: 'Dr-Caramelo', title: 'Dr. Caramelo', year: '2023' },
      { slug: 'No-UserName', title: 'No UserName', year: '2021' },
    ],
    alt: {
      rectangle: 'Vídeo de presentación del proyecto Rectangle que lleva a la página del proyecto.',
      eqapla: 'Vista previa de la landing de e-Qapla que lleva a la página del proyecto.',
      inmape: 'Vista previa del rediseño web de Inmape que lleva a la página del proyecto.',
      arquitech: 'Vídeo de presentación del proyecto ArquiTechPro que lleva a la página del proyecto.',
      cacao: 'Ilustración del proyecto Intrépido Cacao que lleva a la página del proyecto.',
