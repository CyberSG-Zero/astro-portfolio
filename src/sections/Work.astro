---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../icons/BrandMark.astro';
import JavaScript from '../icons/JavaScript.astro';
import Skill128A from '../icons/Skill128A.astro';
import Skill128B from '../icons/Skill128B.astro';
import Skill150A from '../icons/Skill150A.astro';
import Skill256SolidA from '../icons/Skill256SolidA.astro';
import Skill256SolidB from '../icons/Skill256SolidB.astro';
import Skill27A from '../icons/Skill27A.astro';
