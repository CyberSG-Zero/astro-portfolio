      arquitech: 'ArquiTechPro project preview video leading to the project page.',
      cacao: 'Intrépido Cacao artwork leading to the project page.',
      anilist: 'Anilist project preview video leading to the project page.',
      drcaramelo: 'Dr. Caramelo promotional image leading to the project page.',
      nousername: 'NoUserName comic illustration leading to the project page.',
    },
  },
  es: {
    metaTitle: 'Proyectos | CyberSG',
    metaDesc:
      'Experiencia y proyectos seleccionados de CyberSG: diseño UX/UI, desarrollo web y diseño visual para clientes reales.',
    experience: 'Experiencia',
    portfolio: 'Portafolio',
    jobs: [
      {
        role: 'Diseñador UX/UI',
        period: 'Julio 2026 - Actualidad',
        company: 'Paladini Digital',
        desc: 'Diseño sistemas de diseño y desarrollo interfaces para aplicaciones web y móviles.',
      },
      {
        role: 'Desarrollador web',
        period: 'Julio 2024 - Julio 2026',
        company: 'e-Qapla',
        desc: 'Combinando muchas tecnologías, del código al diseño, para crear proyectos limpios, impactantes y disfrutables.',
      },
      {
        role: 'Diseñador de producto',
