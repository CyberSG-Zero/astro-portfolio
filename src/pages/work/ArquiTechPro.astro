---
import Layout from '../../layouts/Layout_project.astro';
---

<Layout title="ArquiTechPro | CyberSG" description="ArquiTechPro - Construction company website designed and developed by CyberSG. UX/UI design, web development, and brand identity.">

    <section class="section section--hero">
        UX/UI •  Web Design • Identity
        <div class="projects">
            <h1 class="display-text">ArquiTechPro</h1>
            <svg class="ani-icon" width="280" height="300" viewBox="0 0 480 512"><path fill="currentColor" d="M471.99 334.43L336.06 256l135.93-78.43c7.66-4.42 10.28-14.2 5.86-21.86l-32.02-55.43c-4.42-7.65-14.21-10.28-21.87-5.86l-135.93 78.43V16c0-8.84-7.17-16-16.01-16h-64.04c-8.84 0-16.01 7.16-16.01 16v156.86L56.04 94.43c-7.66-4.42-17.45-1.79-21.87 5.86L2.15 155.71c-4.42 7.65-1.8 17.44 5.86 21.86L143.94 256L8.01 334.43c-7.66 4.42-10.28 14.21-5.86 21.86l32.02 55.43c4.42 7.65 14.21 10.27 21.87 5.86l135.93-78.43V496c0 8.84 7.17 16 16.01 16h64.04c8.84 0 16.01-7.16 16.01-16V339.14l135.93 78.43c7.66 4.42 17.45 1.8 21.87-5.86l32.02-55.43c4.42-7.65 1.8-17.43-5.86-21.85"/></svg>
        </div>
        <div class="content-description">
            <!-- UX/UI •  Web Design • Identity -->
            <div class="clients-wrapper">
                <div class="clients">
                    <img src="../images/softaki_logo.avif" alt="Logo de Softaki"></img>
                    Softaki Software Solutions
                </div>
            </div>
        </div>

        <div class="meta-row">
            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Role</span>
                </div>
                <div>UX/UI Designer</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Timeline</span>
                </div>
                <div>2024</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Stack</span>
                </div>
                <div>Figma, Ilustrator, Photoshop, CSS, After Effects</div>
            </div>

            
        </div>
    </section>

    <section class="section">
        <video loop preload="none" autoplay muted class="image-large" src="../videos/arquitech.webm"></video>
    </section>

    <section class="section">
        <div class="content-split">
            <div class="copy-block">
                <div class="content-subtitle accent">01 [//] The Context</div>
                <div class="copy">
                    <h2>A brick by brick</h2>
                    <p><strong><i>ArquiTechPro</i></strong> is a construction company located in Lima, Peru (established in Softaki). Their experience is formed by architects, engineers, and qualified masters where quality and responsibility are the basis of our success.</p>
                </div>
            </div>
        </div>
    <!-- <section class="section">
        <video loop preload="none" autoplay muted class="image-large" src="../videos/arquitech.webm"></video>
    </section> -->

    <section class="section full-bleed" style="background-image: url('../images/Collage_ArquiTechPro.avif');">
    </section>


    <section class="section">
        <video loop preload="none" autoplay muted class="image-large" poster="/images/arquitech_portrait.avif" src="../videos/Arquitech_2.webm"></video>
    </section>

    <section class="section">
        <video loop preload="none" autoplay muted class="image-large" src="../videos/Arquitech_3.webm"></video>
    </section>

    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "CreativeWork",
            "name": "ArquiTechPro",
            "description": "Construction company website designed and developed by CyberSG. UX/UI design, web development, and brand identity for Softaki Software Solutions.",
            "url": "https://cybersg.dev/work/ArquiTechPro",
            "image": "https://cybersg.dev/images/Portada_arquitech.avif",
            "author": {
                "@type": "Person",
                "name": "Luis Salas",
                "url": "https://cybersg.dev"
            },
            "creator": {
                "@type": "Person",
                "name": "Luis Salas"
            },
            "datePublished": "2024",
            "genre": "Web Design",
            "about": [
                {
                    "@type": "Thing",
                    "name": "UX/UI Design"
                },
                {
                    "@type": "Thing",
                    "name": "Web Development"
                },
                {
                    "@type": "Thing",
                    "name": "Brand Identity"
                }
            ],
            "workExample": {
                "@type": "WebPage",
                "url": "https://www.eqapla.com/"
            }
        }
    </script>
</Layout>