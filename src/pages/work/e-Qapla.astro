---
import Layout from '../../layouts/Layout_project.astro';
---

<Layout title="e-Qapla | CyberSG" description="A marketing agency is often a fragmented and stressful process for businesses in Lima. e-Qapla identified that potential clients were losing valuable time toggling between multiple courier platforms, facing cluttered interfaces and a total lack of real-time visibility. The challenge was to created a seamless and engaging user experience for e-qapla, highlighting the benefits of their shipping management platform. Explore a clean and modern design that guides users towards action.">
    

    <section class="section section--hero">
        UX/UI •  Web Design • Identity
        <div class="projects">
            <h1 class="display-text">LandingPage - e-Qapla</h1>
            <svg class="ani-icon" width="280" height="300" viewBox="0 0 480 512"><path fill="currentColor" d="M471.99 334.43L336.06 256l135.93-78.43c7.66-4.42 10.28-14.2 5.86-21.86l-32.02-55.43c-4.42-7.65-14.21-10.28-21.87-5.86l-135.93 78.43V16c0-8.84-7.17-16-16.01-16h-64.04c-8.84 0-16.01 7.16-16.01 16v156.86L56.04 94.43c-7.66-4.42-17.45-1.79-21.87 5.86L2.15 155.71c-4.42 7.65-1.8 17.44 5.86 21.86L143.94 256L8.01 334.43c-7.66 4.42-10.28 14.21-5.86 21.86l32.02 55.43c4.42 7.65 14.21 10.27 21.87 5.86l135.93-78.43V496c0 8.84 7.17 16 16.01 16h64.04c8.84 0 16.01-7.16 16.01-16V339.14l135.93 78.43c7.66 4.42 17.45 1.8 21.87-5.86l32.02-55.43c4.42-7.65 1.8-17.43-5.86-21.85"/></svg>
        </div>
        <div class="content-description">
            <!-- UX/UI •  Web Design • Identity -->
            <div class="clients-wrapper">
                <div class="clients">
                    <img src="../images/e-qapla_logo.avif" alt="Logo de e-Qapla"></img>
                    e-Qapla
                </div>
            </div>
        </div>

        <div class="meta-row">
            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Role</span>
                </div>
                <div>UX/UI Designer</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Timeline</span>
                </div>
                <div>2025</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Stack</span>
                </div>
                <div>Figma, Ilustrator, Photoshop, Webflow, CSS, Javascript, Make</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>PROTOTYPE [//] LINK</span>
                </div>
                <a href="https://www.eqapla.com/" target="_blank">https://www.eqapla.com/</a>
            </div>
        </div>
        
    </section>

    <section class="section">
        <img class="image-large" loading="lazy" src="../images/Portada_e-qapla.avif" alt="Imagen de la landingpage de e-qapla con 2 imágenes mostrando partes de la misma landing"></img>
    </section>

    <section class="section">
        <div class="content-split">
            <div class="copy-block">
                <div class="content-subtitle accent">01 [//] The Problem</div>
                <div class="copy">
                    <h2>A beginning of a Journey</h2>
                    <p><strong><i>A marketing agency</i></strong> is often a fragmented and stressful process for businesses in Lima. <br><br>
                    <strong><i>e-Qapla</i></strong> identified that potential clients were losing valuable time toggling between multiple courier platforms, facing cluttered interfaces and a total lack of real-time visibility. The challenge was to created a seamless and engaging <strong><i>user experience for e-qapla, highlighting the benefits of their shipping management platform.</i></strong> Explore a clean and modern design that guides users towards action.</p>
                </div>
            </div>
        </div>
    </section>

