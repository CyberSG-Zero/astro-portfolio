---
import Layout from '../../layouts/Layout_project.astro';
---

<Layout title="Anilist | CyberSG" description="Anilist mobile app concept - UX/UI design project featuring anime tracking functionality. Created by CyberSG with a modern and engaging interface.">
    <section class="section project">
        UX/UI • Web Design • Fictional Situation
        <div class="proyectos">
            <h1 class="display_text">Anilist [//] MobileApp</h1>
            <svg class="ani-icon" width="280" height="300" viewBox="0 0 480 512"><path fill="currentColor" d="M471.99 334.43L336.06 256l135.93-78.43c7.66-4.42 10.28-14.2 5.86-21.86l-32.02-55.43c-4.42-7.65-14.21-10.28-21.87-5.86l-135.93 78.43V16c0-8.84-7.17-16-16.01-16h-64.04c-8.84 0-16.01 7.16-16.01 16v156.86L56.04 94.43c-7.66-4.42-17.45-1.79-21.87 5.86L2.15 155.71c-4.42 7.65-1.8 17.44 5.86 21.86L143.94 256L8.01 334.43c-7.66 4.42-10.28 14.21-5.86 21.86l32.02 55.43c4.42 7.65 14.21 10.27 21.87 5.86l135.93-78.43V496c0 8.84 7.17 16 16.01 16h64.04c8.84 0 16.01-7.16 16.01-16V339.14l135.93 78.43c7.66 4.42 17.45 1.8 21.87-5.86l32.02-55.43c4.42-7.65 1.8-17.43-5.86-21.85"/></svg>
        </div>
        <div class="content-description">
            <div class="clients-wrapper">
                <div class="clients">
                    <img src="../images/AniList_logo.avif" alt="Logo de Anilist"></img>
                    Anilist
                </div>
            </div>
        </div>

        <div class="block horizontal line">
            <div class="experience-container proyectos">
                <div class="content-subtitle">
                    <span>Role</span>
                </div>
                <div>UX/UI Designer</div>
            </div>

            <div class="experience-container proyectos">
                <div class="content-subtitle">
                    <span>Timeline</span>
                </div>
                <div>2022</div>
            </div>

            <div class="experience-container proyectos">
                <div class="content-subtitle">
                    <span>Stack</span>
                </div>
                <div>Figma, Ilustrator, Photoshop, Adobe Premiere, After Effects</div>
            </div>

            <!-- <div class="experience-container proyectos">
                <div class="content-subtitle">
                    <span>PROTOTYPE [//] LINK</span>
                </div>
                <a href="https://www.youtube.com/watch?v=40OqNmCiido" target="_blank">Temp. 1 - Episodio 1 - Youtube</a>
            </div> -->
        </div>
    </section>

    <section class="section">
        <video loop preload="none" autoplay muted class="image-large" src="../videos/anilist.webm"></video>
    </section>

    <section class="section">
        <div class="container project">
            <div class="block project">
                <div class="content-subtitle red">01 [//] The Context</div>
                <div class="block full_width">
                    <h2>A nerdy need</h2>
                    <p>Anilist is an <strong><i>online database and social network for Asian animated series and graphic novels.</i></strong> A mobile app is being developed to enhance the user experience and fully utilize the web version's features.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section">
        <video loop preload="none" autoplay muted class="image-large" src="../videos/anilist_2.webm"></video>
    </section>

    <section class="section">
        <video loop preload="none" autoplay muted class="image-large" src="../videos/anilist_1.webm"></video>
    </section>

    <script defer src="../js/bg-image.js" client:only="react"></script>
</Layout>