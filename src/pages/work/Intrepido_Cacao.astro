---
import Layout from '../../layouts/Layout_project.astro';
---

<Layout title="Intrépido Cacao | CyberSG" description="Las Aventuras del Intrépido Cacao - Animation and character design project featuring a chocolate-themed adventure. Created by CyberSG.">

    <section class="section section--hero">
        Animation • Character Design • Graphic design
        <div class="projects">
            <h1 class="display-text">Las Aventuras del Intrépido Cacao</h1>
            <svg class="ani-icon" width="280" height="300" viewBox="0 0 480 512"><path fill="currentColor" d="M471.99 334.43L336.06 256l135.93-78.43c7.66-4.42 10.28-14.2 5.86-21.86l-32.02-55.43c-4.42-7.65-14.21-10.28-21.87-5.86l-135.93 78.43V16c0-8.84-7.17-16-16.01-16h-64.04c-8.84 0-16.01 7.16-16.01 16v156.86L56.04 94.43c-7.66-4.42-17.45-1.79-21.87 5.86L2.15 155.71c-4.42 7.65-1.8 17.44 5.86 21.86L143.94 256L8.01 334.43c-7.66 4.42-10.28 14.21-5.86 21.86l32.02 55.43c4.42 7.65 14.21 10.27 21.87 5.86l135.93-78.43V496c0 8.84 7.17 16 16.01 16h64.04c8.84 0 16.01-7.16 16.01-16V339.14l135.93 78.43c7.66 4.42 17.45 1.8 21.87-5.86l32.02-55.43c4.42-7.65 1.8-17.43-5.86-21.85"/></svg>
        </div>
        <div class="content-description">
            <!-- UX/UI •  Web Design • Identity -->
            <div class="clients-wrapper">
                <div class="clients">
                    <img src="../images/koolch_logo.avif" alt="Logo de Koolch"></img>
                    Koolch
                </div>
            </div>
        </div>

        <div class="meta-row">
            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Role</span>
                </div>
                <div>Graphic Designer</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Timeline</span>
                </div>
                <div>2023</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Stack</span>
                </div>
                <div>Figma, Ilustrator, Photoshop, Clip Studio Paint, Adobe Premiere, After Effects</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>PROTOTYPE [//] LINK</span>
                </div>
                <a href="https://www.youtube.com/watch?v=40OqNmCiido" target="_blank">Temp. 1 - Episodio 1 - Youtube</a>
            </div>
        </div>
    </section>

    <section class="section">
        <img class="image-large" src="../images/one_cacao.avif" alt="Imagen del Intrépido Cacao y su equipo reunido peleando contra los dulces malvados">
    </section>

    <section class="section">
        <div class="content-split">
            <div class="copy-block">
                <div class="content-subtitle accent">01 [//] The Context</div>
                <div class="copy">
                    <h2>A fight againts unhealthy snacks</h2>
                    <p>This animated series is a fun, cartoonish way to <strong><i>teach kids about healthy snacking,</i></strong> aiming to instill good eating habits through engaging characters and stories.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section full-bleed" style="background-image: url('../images/Collage_koolch.avif');">
    </section>

    <section class="section">
        <img class="image-large" src="/images/portada_cacao.avif"></img>
    </section>

    <section class="section">
        <video loop preload="none" autoplay muted playsinline class="image-large" src="../videos/koolch.webm"></video>
    </section>
</Layout>