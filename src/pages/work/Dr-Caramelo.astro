---
import Layout from '../../layouts/Layout_project.astro';
---

<Layout title="Dr. Caramelo | CyberSG" description="Dr. Caramelo - A fictional UX/UI design project featuring a candy-themed character. Creative interface design by CyberSG.">
    <section class="section section--hero">
        UX/UI • Web Design • Fictional Situation
        <div class="projects">
            <h1 class="display-text">Dr. Caramelo</h1>
            <svg class="ani-icon" width="280" height="300" viewBox="0 0 480 512"><path fill="currentColor" d="M471.99 334.43L336.06 256l135.93-78.43c7.66-4.42 10.28-14.2 5.86-21.86l-32.02-55.43c-4.42-7.65-14.21-10.28-21.87-5.86l-135.93 78.43V16c0-8.84-7.17-16-16.01-16h-64.04c-8.84 0-16.01 7.16-16.01 16v156.86L56.04 94.43c-7.66-4.42-17.45-1.79-21.87 5.86L2.15 155.71c-4.42 7.65-1.8 17.44 5.86 21.86L143.94 256L8.01 334.43c-7.66 4.42-10.28 14.21-5.86 21.86l32.02 55.43c4.42 7.65 14.21 10.27 21.87 5.86l135.93-78.43V496c0 8.84 7.17 16 16.01 16h64.04c8.84 0 16.01-7.16 16.01-16V339.14l135.93 78.43c7.66 4.42 17.45 1.8 21.87-5.86l32.02-55.43c4.42-7.65 1.8-17.43-5.86-21.85"/></svg>
        </div>
        <div class="content-description">
            <div class="clients-wrapper">
                <div class="clients">
                    <img src="../images/upc_logo.avif" alt="Logo de UPC"></img>
                    UPC
                </div>
            </div>
        </div>

        <div class="meta-row">
            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Role</span>
                </div>
                <div>UX/UI Designer</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Timeline</span>
                </div>
                <div>2023</div>
            </div>

            <div class="meta-item">
                <div class="content-subtitle">
                    <span>Stack</span>
                </div>
                <div>Figma, Ilustrator, Photoshop, After Effects</div>
            </div>

            
        </div>
    </section>

    <section class="section">
        <img class="image-large" src="../images/Portada_drcaramelo.avif" alt="Imagen de Portada de Dr. Caramelo que tiene la frase 'El poder de saber todo, analizar todo, evaluar todo sobre tu paciente'."></img>
    </section>

    <section class="section">
        <div class="content-split">
            <div class="copy-block">
                <div class="content-subtitle accent">01 [//] The Context</div>
                <div class="copy">
                    <h2>A nerdy need</h2>
                    <p>Introducing the revolutionary smartwatch for veterinarians: <span class="text-span">Dr. Caramelo.</span> Utilizing holographic technology, it provides critical information to help vets <span class="text-span">better understand their patients.</span></p>
                </div>
            </div>
        </div>
    </section>

    <section class="section full-bleed" style="background-image: url('../images/watch.avif');">
    </section>

    <section class="section">
        <img class="image-large" src="../images/drcaramelo_userx.avif" alt="Imagen de un user persona de los veterinarios entrevistados resaltando su interes en un aparato que les de datos en tiempo real."></img>
    </section>

    <section class="section">
        <img class="image-large" src="../images/dr_watches.avif" alt="Imagen de 3 prototipos del producto final de Dr. Caramelo."></img>
    </section>
</Layout>