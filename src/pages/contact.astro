---

<Layout title="Let’s talk together | CyberSG" description="CyberSG is a Freelancer Web Developer with ilustrations and graphic skills to solve your digital problems. Contact me today to discuss your project!">

	<!-- contact -->
	<section class="section horizontal">
		<div class="container">
			<div class="block">
				<div class="content-subtitle">Contact</div>
				<div class="phrase-ctnr horizontal">
					<h1 class="section-title">Let’s talk together</h1>
					<svg class="ani-icon"
					width="30" height="30" 
					viewBox="0 0 480 512">
					<path fill="currentcolor" d="M471.99 334.43L336.06 256l135.93-78.43c7.66-4.42 10.28-14.2 5.86-21.86l-32.02-55.43c-4.42-7.65-14.21-10.28-21.87-5.86l-135.93 78.43V16c0-8.84-7.17-16-16.01-16h-64.04c-8.84 0-16.01 7.16-16.01 16v156.86L56.04 94.43c-7.66-4.42-17.45-1.79-21.87 5.86L2.15 155.71c-4.42 7.65-1.8 17.44 5.86 21.86L143.94 256L8.01 334.43c-7.66 4.42-10.28 14.21-5.86 21.86l32.02 55.43c4.42 7.65 14.21 10.27 21.87 5.86l135.93-78.43V496c0 8.84 7.17 16 16.01 16h64.04c8.84 0 16.01-7.16 16.01-16V339.14l135.93 78.43c7.66 4.42 17.45 1.8 21.87-5.86l32.02-55.43c4.42-7.65 1.8-17.43-5.86-21.85"/></svg>
				</div>
			</div>
			<div class="content-description full-width home">
				<p> I'm right now in <strong><i>Barcelona, Spain</i></strong>, but I am available for remote work worldwide. <br><br> Whether you're looking to build a new website from scratch or revamp an existing one, I'm here to bring your vision to life. Let's work together to create a website that not only looks great but also drives results for your business.
				</p>
			</div>
			<div class="footer-icon-wrapper">
				<!-- <a class="footer-icon button" href="/">Resume</a> -->
				<a class="footer-icon" href="https://www.instagram.com/cybersg_zero/" target="_blank" aria-label="Instagram">   
					<svg 
					width="24" height="24" 
					viewBox="0 0 24 24"
					aria-hidden="true">
					<path fill="currentColor" d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3"/></svg>
				</a>
				<a class="footer-icon" href="https://www.linkedin.com/in/cybersg/" target="_blank" aria-label="LinkedIn">
					<svg 
					width="24" height="24" 
					viewBox="0 0 24 24"
					aria-hidden="true">
					<path fill="currentColor" d="M6.94 5a2 2 0 1 1-4-.002a2 2 0 0 1 4 .002M7 8.48H3V21h4zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91z"/></svg>
				</a>
<a class="footer-icon" href="https://github.com/CyberSG-Zero" target="_blank" aria-label="GitHub">
					<svg 
					width="24" height="24" viewBox="0 0 24 24"
					aria-hidden="true">
					<path fill="currentColor" d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.10-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.20 2.39.10 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2" />
					</svg>
				</a>
			</div>

			<div class="block">
				<h2 class="content-subtitle">Inquiry</h2>
				<a class="email-link" href="javascript:void(0)" id="copyEmail">
					<span>luissalas2706</span>
					<span>@</span>
					<span>gmail.com</span>
				</a>
				<span id="copyMessage">
					¡Copied to Clipboard!
				</span>
			</div>
			<div>
				Barcelona, Spain // Remote
			</div>

		</div>
		<div class="container">
			<form class="contact_form" action="https://hook.us2.make.com/d4nyv4q8co1r5l1u9u78mqex3v1w3z96" method="POST">
				<input type="text" name="website_url" style="display:none" tabindex="-1" autocomplete="off">
				<label for="Name">
					Name
					<input type="text" name="name" placeholder="Write your full name" required />
				</label>

				<label for="Company Name">
					Company Name
					<input type="text" name="company" placeholder="Write your company name" required />
				</label>

				<label for="Email">
					Email
					<input type="email" name="email" placeholder="Write your your Email" required />
				</label>

				<label for="message">
					Message
					<textarea name="message" placeholder="Your Message" required></textarea>
				</label>

				<fieldset>
					<legend>Select expectation:</legend>

					<div class="radio">
						<input type="radio" id="work" name="Motive" value="work-together" checked />
						<label for="work">To work together | ˆᴗˆ |</label>
					</div>

					<div class="radio">
						<input type="radio" id="talk" name="Motive" value="talk-together" />
						<label for="talk">To talk together  | >ᴗ< |</label>
					</div>
					</fieldset>
				<label class="checkbox" for="consent">
					I consent to having this website store my submitted information so they can respond to my inquiry.
					<input type="checkbox" id="consent" name="consent" required />
					<span class="check"></span>
				</label>
				<button type="submit" disabled>Send Message</button>
			</form>
		</div>
	</section>

	<div itemscope itemtype="https://schema.org/WebSite">
		<meta itemprop="url" content="https://www.cybersg.dev/" />
		<meta itemprop="name" content="CyberSG" />
	</div>

	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "ContactPage",
			"name": "Contact CyberSG",
			"description": "Get in touch with CyberSG - Freelance Web Developer. Available for web development, UX/UI design, and visual design projects.",
			"url": "https://cybersg.dev/contact",
			"contactPoint": {
				"@type": "ContactPoint",
				"contactType": "customer service",
				"email": "luissalas2706@gmail.com",
				"availableLanguage": ["English", "Spanish"]
			},
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Barcelona",
				"addressCountry": "ES",
				"addressRegion": "Catalonia"
			}
		}
	</script>

	<script defer src="./js/submit_button.js"></script>
	<script defer src="./js/copy_to_clipboard.js"></script>
	<script defer src="./js/make.js"></script>
</Layout>
