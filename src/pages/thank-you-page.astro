			<div class="block">
				<a class="email-link" href="javascript:void(0)" id="copyEmail">
					<span>luissalas2706</span>
					<span>@</span>
					<span>gmail.com</span>
				</a>
				<span id="copyMessage">
					¡Copied to Clipboard!
				</span>
